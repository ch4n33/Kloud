# 현재 wg-easy v14와 데이터 형식을 유지하고 Node 실행 파일만 교체한다.
FROM node:22.23.4-alpine@sha256:ebc216c22db53dbde85719a874978d5aec04e6e405ad26a3804c6f9abc4ca1a9 AS node22

FROM ghcr.io/wg-easy/wg-easy@sha256:5f26407fd2ede54df76d63304ef184576a6c1bb73f934a58a11abdd852fab549

COPY --from=node22 /usr/local/bin/node /usr/local/bin/node
